; ============================================================
;  MAZE  -  a CHIP-8 demoscene classic in a few dozen bytes
;
;  The screen is split into a 16 x 8 grid of 4 x 4 pixel cells, and each
;  one gets one of two diagonal strokes at random. The result looks like
;  a maze - and the whole "generator" is one RND.
;
;  With the "DXYN waits for the frame" quirk on, the maze draws line by
;  line - exactly as it did on a real COSMAC VIP.
; ============================================================

    LD  V0, 0           ; x in pixels
    LD  V1, 0           ; y in pixels

row:
    RND V2, 1           ; one random bit
    SE  V2, 0
    LD  I, slashL
    SE  V2, 1
    LD  I, slashR
    DRW V0, V1, 4

    ADD V0, 4
    SE  V0, 64          ; end of the row?
    JP  row

    LD  V0, 0
    ADD V1, 4
    SE  V1, 32          ; end of the screen?
    JP  row

done:
    LD  V2, 4
    LD  ST, V2          ; a short "done" beep
stop:
    JP  stop

slashL:
    gfx #.......
    gfx .#......
    gfx ..#.....
    gfx ...#....

slashR:
    gfx ...#....
    gfx ..#.....
    gfx .#......
    gfx #.......
