; ============================================================
;  PONG  (for one paddle)
;
;  The ball bounces off three walls; the fourth has to be covered by the paddle.
;  Three lives, then a score screen, and any key restarts.
;
;  Controls:  2 = paddle up   8 = paddle down
;
;  Registers:
;    V0 - scratch           V6 - paddle position (y)
;    V1 - move lock         V8 - score
;    V2 - ball x            V9 - lives
;    V3 - ball y            VA - "missed it" flag
;    V4 - dx (2 / 254)      VD, VE - drawing scratch
;    V5 - dy (1 / 255)
; ============================================================

define PADX   62            ; the paddle is one column of pixels
define PADTOP 0
define PADBOT 24
define LIVES  3

main:
    CLS
    LD  V8, 0               ; score
    LD  V9, LIVES
    LD  V6, 12              ; paddle in the middle
    CALL drawpad

newball:
    LD  VA, 0
    LD  V2, 8
    LD  V3, 8
    LD  V4, 2               ; the ball goes right...
    LD  V5, 1               ; ...and down
    LD  I, sprball
    DRW V2, V3, 2

loop:
    LD  I, sprball
    DRW V2, V3, 2           ; erase the ball

    ADD V2, V4
    ADD V3, V5

    SNE V3, 31              ; ceiling / floor
    CALL flipy
    SNE V3, 255
    CALL flipy

    SNE V2, 254             ; left wall
    CALL flipx

    SNE V2, 60              ; the paddle's plane
    CALL paddle

    LD  I, sprball
    DRW V2, V3, 2           ; draw the ball at the new spot

    SE  VA, 1
    JP  tick
    JP  missed

tick:
    LD  V1, 0               ; one paddle move per step
    LD  V0, 1
    LD  DT, V0
twait:
    CALL input
    LD  V0, DT
    SE  V0, 0
    JP  twait
    JP  loop

; ---------------------------------------------------------------- physics
flipy:
    LD  V0, 0
    SUB V0, V5
    LD  V5, V0
    ADD V3, V5              ; step back, already the new way
    RET

flipx:
    LD  V0, 0
    SUB V0, V4
    LD  V4, V0
    ADD V2, V4
    RET

; a hit when  y+1 >= paddle  and  y <= paddle+7
paddle:
    LD  V0, V3
    ADD V0, 1
    SUB V0, V6
    SE  VF, 1
    JP  toohigh
    LD  V0, V6
    ADD V0, 7
    SUB V0, V3
    SE  VF, 1
    JP  toolow
    LD  V0, 0
    SUB V0, V4
    LD  V4, V0
    ADD V2, V4
    ADD V8, 1
    LD  V0, 2
    LD  ST, V0
    RET
toohigh:
    LD  VA, 1
    RET
toolow:
    LD  VA, 1
    RET

; ---------------------------------------------------------------- controls
input:
    SE  V1, 0
    RET
    LD  V0, 2
    SKNP V0
    JP  padup
    LD  V0, 8
    SKNP V0
    JP  paddown
    RET
padup:
    SNE V6, PADTOP
    RET
    CALL drawpad            ; erase at the old spot
    ADD V6, -2
    CALL drawpad
    LD  V1, 1
    RET
paddown:
    SNE V6, PADBOT
    RET
    CALL drawpad
    ADD V6, 2
    CALL drawpad
    LD  V1, 1
    RET

drawpad:
    LD  V0, PADX
    LD  I, sprpad
    DRW V0, V6, 8
    RET

; ---------------------------------------------------------------- a life lost
missed:
    LD  V0, 12
    LD  ST, V0
    LD  V0, 30
    LD  DT, V0
mwait:
    LD  V0, DT
    SE  V0, 0
    JP  mwait

    ADD V9, -1
    SE  V9, 0
    JP  respawn
    JP  gameover
respawn:
    CLS
    CALL drawpad
    JP  newball

gameover:
    CLS
    LD  I, scorebuf
    LD  B, V8
    LD  I, scorebuf
    LD  V2, [I]             ; V0 = hundreds, V1 = tens, V2 = ones
    LD  VD, 26
    LD  VE, 13
    LD  F, V1
    DRW VD, VE, 5
    ADD VD, 6
    LD  F, V2
    DRW VD, VE, 5
    LD  V0, K
    JP  main

; ---------------------------------------------------------------- data
sprball:
    gfx ##......
    gfx ##......
sprpad:
    gfx #.......
    gfx #.......
    gfx #.......
    gfx #.......
    gfx #.......
    gfx #.......
    gfx #.......
    gfx #.......
scorebuf:
    db  0, 0, 0
