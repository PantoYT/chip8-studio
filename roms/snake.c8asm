; ============================================================
;  SNAKE
;
;  Board: 16 x 8 cells of 4 x 4 pixels.
;  A cell packed into one byte:  (column << 4) | row
;  The snake's body is a 64-byte ring buffer at address BODY.
;
;  Controls:  2 = up   8 = down   4 = left   6 = right
;
;  Registers:
;    V0, V1 - scratch             V8 - scan loop counter
;    V2 - head column             V9 - packed cell
;    V3 - head row                VA - score
;    V4 - direction (0..3)        VB - turn lock / grow flag
;    V5 - head index in buffer    VC - scan result
;    V6 - tail index              VD, VE - pixel coordinates
;    V7 - packed food position
; ============================================================

define BODY   0x400         ; 64-byte ring buffer
define RING   63            ; buffer mask
define SPEED  3             ; delay between steps (frames)
define MAXLEN 39            ; past this the snake stops growing

; ---------------------------------------------------------------- game start
main:
    CLS
    LD  V4, 1               ; start direction: right
    LD  VA, 0               ; score
    LD  V5, 0               ; head index
    LD  V6, 0               ; tail index
    LD  V3, 4               ; row
    LD  V2, 2               ; column - the snake starts as three cells

initbody:
    CALL pack
    LD  I, BODY
    ADD I, V5
    LD  V0, V9
    LD  [I], V0
    CALL drawbody
    SE  V2, 4
    JP  initstep
    JP  initdone
initstep:
    ADD V5, 1
    ADD V2, 1
    JP  initbody
initdone:
    CALL newfood

; ---------------------------------------------------------------- game loop
loop:
    ; --- move the head in the current direction
    SNE V4, 0
    ADD V3, -1              ; up
    SNE V4, 1
    ADD V2, 1               ; right
    SNE V4, 2
    ADD V3, 1               ; down
    SNE V4, 3
    ADD V2, -1              ; left

    ; --- a wall?  (1 taken from zero leaves 255, so SUB catches both sides)
    LD  V0, 15
    SUB V0, V2
    SE  VF, 1
    JP  dead
    LD  V0, 7
    SUB V0, V3
    SE  VF, 1
    JP  dead

    ; --- its own tail?
    CALL pack
    CALL occupied
    SE  VC, 0
    JP  dead

    ; --- food?
    LD  VB, 0
    SNE V9, V7
    CALL eat

    ; --- add the new head to the buffer and draw it
    ADD V5, 1
    LD  V0, RING
    AND V5, V0
    LD  I, BODY
    ADD I, V5
    LD  V0, V9
    LD  [I], V0
    CALL drawbody

    ; --- not growing: remove the tail
    SE  VB, 0
    JP  skiptail
    LD  I, BODY
    ADD I, V6
    LD  V0, [I]
    CALL drawbody           ; the same sprite on the same spot = erased
    ADD V6, 1
    LD  V0, RING
    AND V6, V0
skiptail:

    ; --- new food only after the tail is gone, so it can't land on a taken cell
    SE  VB, 1
    JP  nofood
    CALL newfood
nofood:

    ; --- pause; keys are read meanwhile
    LD  VB, 0               ; one turn per step
    LD  V0, SPEED
    LD  DT, V0
wait:
    CALL input
    LD  V0, DT
    SE  V0, 0
    JP  wait
    JP  loop

; ---------------------------------------------------------------- food
eat:
    LD  VB, 1
    LD  V0, V7
    CALL drawfood           ; erase what was eaten
    ADD VA, 1
    LD  V0, 4
    LD  ST, V0
    LD  V0, MAXLEN
    SUB V0, VA
    SE  VF, 1
    LD  VB, 0               ; maximum length reached - only the score grows
    RET

newfood:
    RND V9, 0xF7            ; column 0-15 in the high nibble, row 0-7 in the low
    CALL occupied
    SE  VC, 0
    JP  newfood
    LD  V7, V9
    LD  V0, V7
    CALL drawfood
    RET

; ---------------------------------------------------------------- controls
input:
    SE  VB, 0               ; already turned this step?
    RET
    LD  V0, 2
    SKNP V0
    JP  turnup
    LD  V0, 8
    SKNP V0
    JP  turndown
    LD  V0, 4
    SKNP V0
    JP  turnleft
    LD  V0, 6
    SKNP V0
    JP  turnright
    RET

turnup:
    SNE V4, 2               ; a 180 degree turn is ignored
    RET
    LD  V4, 0
    LD  VB, 1
    RET
turnright:
    SNE V4, 3
    RET
    LD  V4, 1
    LD  VB, 1
    RET
turndown:
    SNE V4, 0
    RET
    LD  V4, 2
    LD  VB, 1
    RET
turnleft:
    SNE V4, 1
    RET
    LD  V4, 3
    LD  VB, 1
    RET

; ---------------------------------------------------------------- helpers
; V2, V3  ->  V9 = (column << 4) | row
pack:
    LD  V9, V2
    SHL V9
    SHL V9
    SHL V9
    SHL V9
    OR  V9, V3
    RET

; V0 = packed cell  ->  VD, VE = top left corner in pixels
topixel:
    LD  VD, V0
    SHR VD
    SHR VD
    SHR VD
    SHR VD
    SHL VD
    SHL VD                  ; column * 4
    LD  VE, V0
    LD  V1, 15
    AND VE, V1
    SHL VE
    SHL VE                  ; row * 4
    RET

drawbody:
    CALL topixel
    LD  I, sprbody
    DRW VD, VE, 3
    RET

drawfood:
    CALL topixel
    LD  I, sprfood
    DRW VD, VE, 3
    RET

; V9 = the cell to find  ->  VC = 1 if the snake is on it
occupied:
    LD  VC, 0
    LD  V8, V6              ; from the tail...
scanloop:
    LD  I, BODY
    ADD I, V8
    LD  V0, [I]
    SNE V0, V9
    LD  VC, 1
    SE  V8, V5              ; ...to the head, inclusive
    JP  scannext
    RET
scannext:
    ADD V8, 1
    LD  V1, RING
    AND V8, V1
    JP  scanloop

; ---------------------------------------------------------------- game over
dead:
    LD  V0, 16
    LD  ST, V0
    LD  V0, 45
    LD  DT, V0
deadwait:
    LD  V0, DT
    SE  V0, 0
    JP  deadwait

    CLS
    LD  I, scorebuf
    LD  B, VA
    LD  I, scorebuf
    LD  V2, [I]             ; V0 = hundreds, V1 = tens, V2 = ones
    LD  VD, 26
    LD  VE, 13
    LD  F, V1
    DRW VD, VE, 5
    ADD VD, 6
    LD  F, V2
    DRW VD, VE, 5

    LD  V0, K               ; any key starts over
    JP  main

; ---------------------------------------------------------------- data
sprbody:
    gfx ###.....
    gfx ###.....
    gfx ###.....
sprfood:
    gfx .#......
    gfx ###.....
    gfx .#......
scorebuf:
    db  0, 0, 0
