; ============================================================
;  BOUNCING BALL  -  the smallest sensible CHIP-8 program
;  A ball flies around the screen and beeps at every bounce.
;
;  Registers:  V0 = x   V1 = y   V2 = dx   V3 = dy   V4 = scratch
; ============================================================

    LD  V0, 20          ; start position
    LD  V1, 8
    LD  V2, 1           ; direction: 1 = right, 255 = left
    LD  V3, 1           ; direction: 1 = down,  255 = up
    LD  I, ball
    DRW V0, V1, 4       ; first draw - without it the loop would erase
                        ; nothing and leave a ghost at the start position

loop:
    DRW V0, V1, 4       ; XOR onto the same spot = the ball is erased

    ADD V0, V2          ; horizontal move
    SNE V0, 61          ; reached the right edge?
    CALL bounceX
    SNE V0, 255         ; ...or the left one (0 - 1 = 255)
    CALL bounceX

    ADD V1, V3          ; vertical move
    SNE V1, 29
    CALL bounceY
    SNE V1, 255
    CALL bounceY

    DRW V0, V1, 4       ; draw at the new spot

    LD  V4, 1           ; a short pause, so it can be watched
    LD  DT, V4
wait:
    LD  V4, DT
    SE  V4, 0
    JP  wait
    JP  loop

; --- bounce: flip the velocity's sign and step back once --------------
bounceX:
    LD  V4, 0
    SUB V4, V2          ; V4 = -dx
    LD  V2, V4
    ADD V0, V2
    JP  beep

bounceY:
    LD  V4, 0
    SUB V4, V3
    LD  V3, V4
    ADD V1, V3
    JP  beep

beep:
    LD  V4, 2
    LD  ST, V4
    RET

; --- graphics ---------------------------------------------------------
ball:
    gfx .##.....
    gfx ####....
    gfx ####....
    gfx .##.....
